# ============================================================
# Wymagane zmienne środowiskowe — sklep Mollien
# ============================================================
# Skopiuj do .env.local (dev) i uzupełnij. Na produkcji ustaw w panelu
# hostingu. UWAGA: brak niektórych zmiennych NIE wywala builda — wyłącza
# funkcję po cichu (szczegóły niżej).

# ---- Supabase ----
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role — TYLKO serwer (sync BL, webhook, admin). Nigdy do klienta.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_live_...
# Podpis webhooka: Dashboard → Developers → Webhooks → endpoint /api/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- BaseLinker ----
# Konto → Moje konto → API
BASELINKER_API_TOKEN=...
# ID statusu BL, na który trafiają nowe opłacone zamówienia.
# Listę statusów zwraca GET /api/baselinker/test (jako admin) → order_statuses.
# BRAK tej zmiennej po cichu WYŁĄCZA push zamówień do BL (ślad w
# orders.baselinker_push_error).
BASELINKER_DEFAULT_STATUS_ID=
# Sekret dla crona /api/baselinker/sync-products i /api/baselinker/push-order.
# Przekazuj nagłówkiem `x-sync-secret` (query ?key= działa, ale ląduje w logach).
BASELINKER_SYNC_SECRET=

# ---- Aplikacja ----
# Publiczny URL sklepu — fallback dla redirectów Stripe gdy brak nagłówka
# Origin. Na produkcji USTAW (inaczej fallback to http://localhost:3000).
NEXT_PUBLIC_APP_URL=https://mollien.pl

# Sekret dla Vercel Cron (/api/cron/reconcile-bl — rekoncyliacja pushów do BL).
# Vercel dokleja go automatycznie jako `Authorization: Bearer $CRON_SECRET`.
# Ustaw w panelu Vercel → Settings → Environment Variables. Ręczny test działa
# też przez nagłówek `x-sync-secret: $BASELINKER_SYNC_SECRET`.
CRON_SECRET=

# Mapowanie statusów BaseLinker → status sklepu (sync statusów zamówień przez
# cron reconcile-bl). Listy numerycznych status_id BL po przecinku — id-ki z
# /api/baselinker/test (getOrderStatusList). Puste = sync statusów wyłączony.
BL_STATUS_PROCESSING_IDS=
BL_STATUS_SHIPPED_IDS=
BL_STATUS_DELIVERED_IDS=
BL_STATUS_CANCELLED_IDS=
