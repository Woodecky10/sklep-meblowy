# ============================================================
# Wymagane zmienne środowiskowe — sklep Mollien
# ============================================================
# Skopiuj do .env.local (dev) i uzupełnij. Na produkcji ustaw w panelu
# hostingu. UWAGA: brak niektórych zmiennych NIE wywala builda — wyłącza
# funkcję po cichu (szczegóły niżej).

# ---- Supabase ----
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role — TYLKO serwer (webhook, admin). Nigdy do klienta.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Przelewy24 (PayPro) — direct REST API v1 ----
# Dane z panelu: https://panel.przelewy24.pl lub https://sandbox.przelewy24.pl
P24_MERCHANT_ID=...
P24_POS_ID=...
P24_API_KEY=...
P24_CRC=...
# Sandbox: https://sandbox.przelewy24.pl | Produkcja: https://secure.przelewy24.pl
P24_BASE_URL=https://sandbox.przelewy24.pl

# ---- Aplikacja ----
# Publiczny URL sklepu — fallback dla redirectów płatności gdy brak nagłówka
# Origin. Na produkcji USTAW (inaczej fallback to http://localhost:3000).
NEXT_PUBLIC_APP_URL=https://mollien.pl

# Maile transakcyjne (Resend). Bez RESEND_API_KEY wysyłka jest wyłączona —
# kod działa, tylko loguje pominięcie. Adresy: patrz spec maili transakcyjnych.
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
MAIL_ADMIN_TO=
